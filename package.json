{
  "name": "@ahumandev/autocode",
  "version": "0.13.0",
  "type": "module",
  "private": false,
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahumandev/autocode.git"
  },
  "homepage": "https://ahumandev.github.io/autocode",
  "bugs": {
    "url": "https://github.com/ahumandev/autocode/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai-agents",
    "agent-workflow",
    "job-workflow",
    "workflow-automation",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun scripts/build.ts build",
    "install:shim": "bun src/install.ts",
    "watch": "bun scripts/build.ts watch",
    "copy:skills": "bun scripts/copy-skill-sources.ts",
    "skill:sync": "bun scripts/sync-github-skills.ts",
    "test": "bun test src --isolate --reporter=dots",
    "tests": "bun test src --isolate --reporter=dots",
    "typecheck": "bun x tsc --noEmit",
    "verify:package": "bun scripts/verify-package-artifacts.ts",
    "release:version": "bun scripts/release-version.ts",
    "prepublishOnly": "bun run test && bun run typecheck && bun run build && bun run verify:package",
    "verify:sandbox-online": "node scripts/verify-sandbox-online.mjs",
    "lint": "biome lint src scripts",
    "lint:fix": "biome lint --write src scripts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.17.18",
    "@opencode-ai/sdk": "1.17.18",
    "gray-matter": "4.0.3",
    "jsonc-parser": "3.3.1",
    "ssh2": "1.17.0",
    "yaml": "2.9.0",
    "youtubei.js": "18.0.0",
    "youtube-transcript": "1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@dqbd/tiktoken": "1.0.22",
    "@types/bun": "1.3.14",
    "@types/ssh2": "1.15.5",
    "fast-check": "4.9.0",
    "typescript": "6.0.3"
  }
}
